# Copy to .env and fill in. Never commit .env. Docker Compose reads secrets only from this file.
# Keep comments on their own lines: tools disagree on how to parse a comment after a value.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_EMAILS=admin@example.com

# LLM. Default: Groq (free tier) running the open-weight gpt-oss-120b.
# Providers: groq | nvidia | gemini | openai | anthropic | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# gpt-oss only: low | medium | high. Low uses fewer tokens and answers faster.
# LLM_REASONING_EFFORT=low

# Get one at console.groq.com, API Keys.
GROQ_API_KEY=
# build.nvidia.com, for LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=
# aistudio.google.com, for LLM_PROVIDER=gemini (set LLM_MODEL to a model id listed in AI Studio)
# GOOGLE_API_KEY=
# For LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Local (non-Docker) runs only; Docker Compose sets these itself.
# DATABASE_URL=sqlite:///./data/app.db
# REDIS_URL=redis://localhost:6379/0
# EMBEDDING_PROVIDER=fastembed
